# Stock Dashboard Environment Variables — copy to .env and fill in

# The @ai-sdk/google package reads this key automatically
GOOGLE_GENERATIVE_AI_API_KEY=

# LM Studio local fallback — OpenAI-compatible server running on your machine
# Start LM Studio, load a model, and enable the local server (default port 1234)
# Set LMSTUDIO_MODEL to the exact model name shown in LM Studio's server tab
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct

# Optional: override the python binary pybridge uses (defaults to the venv)
# PYTHON_PATH=

# One-time portfolio -> ledger migration gate. Already run on the live DB.
# Do NOT set this again.
# ENABLE_LEDGER_MIGRATION=1
