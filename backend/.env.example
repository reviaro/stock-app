# Stock Dashboard Environment Variables — copy to .env and fill in

# The @ai-sdk/google package reads this key automatically
GOOGLE_GENERATIVE_AI_API_KEY=

# LM Studio local fallback — OpenAI-compatible server running on your machine
# Start LM Studio, load a model, and enable the local server (default port 1234)
# Set LMSTUDIO_MODEL to the exact model name shown in LM Studio's server tab
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-7b-instruct

# Optional: override the python binary pybridge uses (defaults to the venv)
# PYTHON_PATH=

# Required single-user dashboard authentication.
# Generate the scrypt password hash with the interactive, history-safe command in README.md.
STOCK_DASHBOARD_USERNAME=dashboard-user
STOCK_DASHBOARD_PASSWORD_HASH=
STOCK_DASHBOARD_SESSION_SECRET=
# Optional bearer token for non-browser automation. Loopback automation is allowed by default.
STOCK_DASHBOARD_API_TOKEN=
STOCK_DASHBOARD_ALLOW_LOOPBACK=1
# Loopback-only by design. Put a TLS reverse proxy on the same host for remote access.
STOCK_DASHBOARD_HOST=127.0.0.1
# Optional exact HTTPS browser origin when served through that reverse proxy.
STOCK_DASHBOARD_PUBLIC_ORIGIN=
# Must be explicitly 0 or 1. Use 1 whenever HTTPS is enabled.
STOCK_DASHBOARD_SECURE_COOKIE=0

# Market-data batching/cache controls (defaults shown).
MARKET_QUOTE_CACHE_TTL_MS=60000
MARKET_QUOTE_STALE_TTL_MS=900000
MARKET_QUOTE_BATCH_DELAY_MS=15
MARKET_SUMMARY_CACHE_TTL_MS=60000
PYTHON_TIMEOUT_MS=45000
PYTHON_MAX_OUTPUT_BYTES=5242880

# Alpaca paper integration only. The service rejects the live broker endpoint.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# Order submission remains disabled unless BOTH values below are explicitly set.
ALPACA_PAPER_ORDER_ENTRY_ENABLED=false
ALPACA_PAPER_ORDER_ENTRY_TOKEN=

# One-time portfolio -> ledger migration gate. Already run on the live DB.
# Do NOT set this again.
# ENABLE_LEDGER_MIGRATION=1
