# Optional settings for npm run start:sample only.
# Copy to .env.sample. Never copy the normal .env or broker credentials.
# Leave empty for a sample without a configured cloud model.
AI_PROVIDER=gemini
# Required for openai/anthropic. Use a model available in your API account.
AI_MODEL=
# Disable local fallback for predictable recordings; set true if wanted.
AI_LOCAL_FALLBACK=false
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
# Optional absolute Python executable paths; existing venvs are used by default.
PYTHON_PATH=
PORTFOLIO_LAB_PYTHON=
